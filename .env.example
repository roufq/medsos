APP_NAME=Goravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_URL=http://localhost
APP_HOST=127.0.0.1
APP_PORT=3000
HTTP_BODY_LIMIT_KB=25600
HTTP_HEADER_LIMIT_BYTES=8192
HTTP_REQUEST_TIMEOUT_SECONDS=10
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Required: use at least 32 random characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_MAX_IDLE_CONNS=25
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_IDLE_SECONDS=300
DB_CONN_MAX_LIFETIME_SECONDS=1800

# Disabled by default. ADMIN_PASSWORD must be at least 12 characters when enabled.
SEED_DEFAULT_ADMIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

SESSION_SECURE=false

GRPC_HOST=
GRPC_PORT=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
